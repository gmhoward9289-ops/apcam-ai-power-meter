# Captured telemetry never belongs in the repo. These files describe a specific
# machine and its network: client identifiers, prompt sizes, model inventory.
# The dataset.*/history.* patterns cover the per-source defaults the -Source
# adapters write (dataset.llamacpp.json, history.vllm.json, ...).
dataset.json
dataset.*.json
history.json
history.*.json
history.json.old
machine.json
dashboard.html
refresh.log
refresh.log.old

# the sample dataset IS tracked - it is synthetic
!sample/dataset.sample.json

# editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# generated demo pages (build.ps1 -Dataset ..\sample\... -OutFile demo.html);
# demo-multi.html is the same for a two-machine build
demo.html
demo-multi.html
